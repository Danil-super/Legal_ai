# Copy to /etc/dental-legal-ai/app.env on the VPS; do not commit the copied file.
COMPOSE_PROJECT_NAME=dental-legal-ai
LEGAL_CORE_PORT=8000
POSTGRES_LOCAL_PORT=5432

POSTGRES_DB=dental_legal
POSTGRES_USER=dental_legal
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD
POSTGRES_APP_USER=dental_legal_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_GENERATED_PASSWORD

MINIO_ROOT_USER=dental_legal
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD
MINIO_BUCKET=clinic-documents
MINIO_REGION=us-east-1

TELEGRAM_BOT_TOKEN=REPLACE_WITH_THE_PRODUCTION_TELEGRAM_TOKEN
BOOTSTRAP_TELEGRAM_ADMIN_ID=REPLACE_WITH_NUMERIC_TELEGRAM_ID
BOOTSTRAP_CLINIC_NAME=Моя стоматология
PLATFORM_OWNER_TELEGRAM_ID=REPLACE_WITH_NUMERIC_TELEGRAM_ID
# Generate a unique 32+ character value; do not reuse AGENT_INTERNAL_KEY.
LEGAL_EDITOR_GATEWAY_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_SECRET

ALLOW_SYNTHETIC_CLINIC_FIXTURES=0
AGENT_ORCHESTRATOR_URL=
AGENT_INTERNAL_KEY=
