COMPOSE_PROJECT_NAME=dental-legal-ai
LEGAL_CORE_PORT=8000
POSTGRES_LOCAL_PORT=5432
TELEGRAM_BOT_TOKEN=
BOOTSTRAP_TELEGRAM_ADMIN_ID=
BOOTSTRAP_CLINIC_NAME="Моя стоматология"
PLATFORM_OWNER_TELEGRAM_ID=

# Database owner: used for role provisioning and Alembic migrations only.
POSTGRES_DB=dental_legal
POSTGRES_USER=dental_legal
POSTGRES_PASSWORD=replace-with-a-local-only-owner-password

# Least-privilege application login: all Legal Core runtime queries use this identity.
POSTGRES_APP_USER=dental_legal_app
POSTGRES_APP_PASSWORD=replace-with-a-different-32-plus-character-runtime-password

MINIO_ROOT_USER=dental_legal
MINIO_ROOT_PASSWORD=replace-with-a-local-only-minio-password
MINIO_BUCKET=clinic-documents
MINIO_REGION=us-east-1

# The local Compose profile maps the internal Legal Core S3 client to the MinIO root credentials.
# Production must replace this with a dedicated service account/policy limited to this bucket.

# Development-only synthetic Test-Dent Clinic Documents loader. Keep disabled by default.
# Applying fixtures also requires the CLI --apply flag and a loopback/internal Legal Core target.
ALLOW_SYNTHETIC_CLINIC_FIXTURES=0

# Optional hybrid legal retrieval. Only APPROVED public legal fragments and fixed product-reviewed
# legal query phrases may use this embedding boundary; patient/service free text stays local FTS.
LEGAL_EMBEDDING_BASE_URL=
LEGAL_EMBEDDING_API_KEY=
LEGAL_EMBEDDING_MODEL=
# Stable versioned identifier, e.g. openai:text-embedding-3-small:v1
LEGAL_EMBEDDING_MODEL_KEY=
LEGAL_EMBEDDING_DIMENSIONS=

# Optional analysis profile. Keep disabled until the pinned, tool-free Hermes deployment is ready.
AGENT_ORCHESTRATOR_URL=
AGENT_INTERNAL_KEY=

# External/pre-existing Hermes endpoints can still be wired directly into the base analysis profile.
HERMES_RESEARCHER_URL=
HERMES_RESEARCHER_API_KEY=
HERMES_RESEARCHER_MODEL=researcher
HERMES_REVIEWER_URL=
HERMES_REVIEWER_API_KEY=
HERMES_REVIEWER_MODEL=reviewer

# Pinned Hermes overlay (ops/hermes/docker-compose.hermes.yml).
# Provider/model choice is deployment-specific and requires the separate privacy/data review.
HERMES_LLM_BASE_URL=
HERMES_LLM_API_KEY=
HERMES_RESEARCHER_LLM_MODEL=
HERMES_REVIEWER_LLM_MODEL=

# Optional maintenance profile. The watcher has no DB access; the importer mounts its inbox read-only
# and can only create immutable REVIEW_REQUIRED discovery records after Legal Core is healthy.
LEGAL_WATCH_INTERVAL_SECONDS=21600
LEGAL_WATCH_IMPORT_INTERVAL_SECONDS=300
